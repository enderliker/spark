fn fib(n) {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

for (var i = 0; i <= 10; i += 1) {
    print("fib(" + str(i) + ") =", fib(i));
}

// Iterative version, much faster for large values.
fn fib_iter(n) {
    var a = 0;
    var b = 1;
    for (var i = 0; i < n; i += 1) {
        var next = a + b;
        a = b;
        b = next;
    }
    return a;
}

print("fib_iter(50) =", fib_iter(50));