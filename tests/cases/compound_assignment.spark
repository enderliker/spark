var x = 7;
x %= 4;
print(x);

var a = nil;
a ??= 5;
print(a);
a ??= 9;
print(a);

var b = 1;
b ??= 9;
print(b);

var m = {"k": nil};
m.k ??= 3;
print(m.k);
m.k ??= 8;
print(m.k);

var values = [1, 2, 3];
values[1] += 10;
print(values);
values[1] %= 4;
print(values);

var flags = 0b1100;
flags &= 0b1010;
print(flags);
flags |= 0b0001;
print(flags);
flags ^= 0b1111;
print(flags);
flags <<= 2;
print(flags);
flags >>= 1;
print(flags);

var text = "a";
text += "b";
print(text);
