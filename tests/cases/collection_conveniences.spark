// count: arrays by value, text by non-overlapping substring, maps by value.
print(count([1, 2, 1, 3, 1], 1));
print(count(["a", "b", "a"], "a"));
print(count([1, 2], 2.0));
print(count("banana", "a"));
print(count("aaaa", "aa"));
print(count("abc", ""));
print(count({"x": 1, "y": 2, "z": 1}, 1));
print(count(bytes_from([7, 7, 8]), 7));
print(count(bytes_from([1, 2, 3, 4]), bytes_from([2, 3])));

// split takes an optional field limit; the last field keeps the remainder.
print(split("a,b,c", ","));
print(split("a,b,c", ",", 2));
print(split("a,,b", ","));
print(split("a,b,c", ",", 0));
print(split("abc", "", 2));

// trim strips whitespace by default and any of the given characters otherwise.
print(trim("  hi  ") + "!");
print(trim("xxhixx", "x"));
print(trim("ñandú", "ñú"));
print(trim("abc", ""));

// range accepts a step; a negative step counts down.
print(range(5));
print(range(2, 5));
print(range(0, 10, 3));
print(range(5, 0, -2));
print(range(0, 5, -1));
print(range(3, 3));

// sort takes an optional comparator, stays stable, and matches sort_by.
var words = ["bb", "a", "ccc", "dd"];
sort(words, fn(x, y) { return len(x) < len(y); });
print(words);

var by_length = ["bb", "a", "ccc", "dd"];
sort_by(by_length, fn(x, y) { return len(x) < len(y); });
print(str(words) == str(by_length));
print(sort([3, 1, 2]));
print(sort(["b", "a", "c"]));

// shuffle and choice share rand's PRNG, so srand makes them reproducible.
srand(2026);
var first = shuffle(range(10));
srand(2026);
var second = shuffle(range(10));
print(str(first) == str(second));
print(sort(first));
print(shuffle([42]));

srand(99);
var draw = choice(range(100));
srand(99);
print(draw == choice(range(100)));
print(draw >= 0 and draw < 100);

// choice consumes the same draw rand does for the same seed.
srand(7);
var expected = rand();
srand(7);
print(choice(range(100)) == int(expected * 100));

var same = [1, 2, 3];
print(shuffle(same) == same);

// The builder natives behind the method sugar are reachable directly.
var builder = bytes_builder();
bb_append(builder, 65);
print(bb_len(builder), bb_to_bytes(builder));
bb_clear(builder);
print(bb_len(builder));

print("conveniences ok");