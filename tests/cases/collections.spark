// Array and map helpers.
var numbers = [3, 1, 4, 1, 5];
print(contains(numbers, 4), contains(numbers, 9));
print(index_of(numbers, 1), index_of(numbers, 9));

insert(numbers, 0, 99);
print(numbers);
print(remove(numbers, 0));
print(numbers);

reverse(numbers);
print(numbers);
fill(numbers, 7);
print(numbers);

print(slice([10, 20, 30, 40], 1));
print(slice([10, 20, 30, 40], 1, 3));
print(slice([10, 20, 30, 40], 2, 99));
print(slice([10, 20, 30, 40], 3, 1));

var data = {"a": 1, "b": 2};
print(contains(data, "a"), contains(data, "z"));
print(get(data, "a"), get(data, "z"), get(data, "z", 0));
clear(data);
print(len(data), has(data, "a"));

var extra = {"b": 20, "c": 30};
var merged = merge({"a": 1}, extra);
print(get(merged, "a"), get(merged, "b"), get(merged, "c"), len(merged));

// Edge cases.
insert(numbers, len(numbers), 8);
print(numbers);
print(remove(numbers, len(numbers) - 1));
print(numbers);

var base = [1, 2, 3];
var part = slice(base, 1);
part[0] = 99;
print(base, part);

var self = {"a": 1, "b": 2};
merge(self, self);
print(len(self), get(self, "a"), get(self, "b"));
print(get({"a": nil}, "a", 9));

clear(data);
data["x"] = 5;
print(len(data), data["x"]);