// VM integration for `bytes` (phase 22, T109): indexing, slicing, iteration,
// lookup, concatenation and the mutable builder.

var text = bytes_from("Spark");

// Indexing yields the byte value, and negative positions count from the end.
print("index:", text[0], text[4], text[-1], text[-5]);
print("len:", len(text));

// Slicing clamps like arrays and strings; the result is bytes again.
print("slice:", text[1:3], text[:2], text[2:], text[0:99], text[-99:2]);
print("step:", text[::2], text[::-1]);
print("empty:", text[3:3], text[9:], text[-9:-8]);

// The `slice(value, start, end)` native agrees with the syntax.
print("native:", slice(text, 1, 3), slice(text, 2), slice(text, -2), slice(text, 4, 1));

// Iteration yields integers and allocates nothing per element.
var sum = 0;
for (var byte in text) {
    sum = sum + byte;
}
print("sum:", sum);

var pairs = [];
for (var index, byte in text) {
    push(pairs, "${index}=${byte}");
}
print("pairs:", pairs);

// Lookup takes an integer byte value or a bytes subsequence, never text.
// Offsets are byte offsets.
print("contains:", contains(text, 112), contains(text, 100), contains(text, bytes_from("par")), contains(text, bytes_from("xyz")));
print("index_of:", index_of(text, 112), index_of(text, bytes_from("ark")), index_of(text, 200), index_of(text, bytes_from("zz")));
print("in:", 112 in text, bytes_from("par") in text, 200 in text);

// Concatenation is bytes + bytes only; the result is a new immutable value.
var greeting = bytes_from("Spa") + bytes_from("rk");
print("concat:", greeting, greeting == text, len(text + bytes(0)));

// The builder is the one mutable companion; to_bytes copies it.
var builder = bytes_builder();
print("builder empty:", builder, builder.len());
builder.append(65);
builder.append(bytes_from("BC"));
print("builder:", builder, builder.len(), builder.to_bytes());
print("copy:", builder.to_bytes() == bytes_from("ABC"));
builder.clear();
print("cleared:", builder.len(), builder.to_bytes());
print("globals:", bb_append(bytes_builder(bytes_from("x")), 121));
print("initial:", bytes_builder(bytes_from("hi")), bytes_builder(2).len());

// Both objects report their type and print in the preview form.
print("type:", type(text), type(builder));
