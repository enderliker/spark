print(1 + 2 * 3);
print((1 + 2) * 3);
print(10 / 4);
print(10 % 3);
print(-5 + 2);
print(2 + 3 * 4 - 6 / 3);
print(1 < 2, 2 <= 2, 3 > 4, 4 >= 4);
print(1 == 1, 1 != 2, "a" == "a", "a" == "b");
print(true and false, true or false, not true, !false);
print(0 and 5);
print(nil or "alternativa");
print(1 + 2 == 3 and 2 * 3 == 6);
