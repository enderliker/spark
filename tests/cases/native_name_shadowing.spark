// Before the program defines its own, the native is the one being called.
print(count([1, 1, 2], 1));

// A top-level function shadows a native of the same name, and self-recursion
// through that name is still tail-call optimized.
fn count(n, acc) {
    if (n == 0) {
        return acc;
    }
    return count(n - 1, acc + 1);
}
print(count(100000, 0));

fn abs(x) {
    return x < 0 ? -x : x;
}
print(abs(-7));

// Mutual recursion where one of the names is also a native.
fn choice(n) {
    return n == 0 ? true : pick(n - 1);
}

fn pick(n) {
    return n == 0 ? false : choice(n - 1);
}
print(choice(100000));
print(choice(99999));

// A native stays reachable through a different name.
var trim_copy = trim;
print(trim_copy("  x  ") + "!");

print("shadowing ok");