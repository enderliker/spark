fn fib(n) {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}
print(fib(15));

fn total(a, b) {
    return a + b;
}
print(total(2, 3));

fn no_return() {
    var x = 1;
}
print(no_return());

fn apply(f, x) {
    return f(x);
}
print(apply(fn(v) { return v * v; }, 7));

fn double(x) {
    return x * 2;
}
print(apply(double, 21));
