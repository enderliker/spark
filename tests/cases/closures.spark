fn make_counter() {
    var n = 0;
    return fn() {
        n += 1;
        return n;
    };
}
var c1 = make_counter();
var c2 = make_counter();
print(c1(), c1(), c2(), c1());

fn make_adder(base) {
    return fn(x) { return base + x; };
}
print(make_adder(10)(5));

fn make_readers() {
    var readers = [];
    for (var i = 0; i < 3; i += 1) {
        var value = i * 10;
        push(readers, fn() { return value; });
    }
    return readers;
}
var fs = make_readers();
print(fs[0](), fs[1](), fs[2]());

var greeting = "hello";
fn greet(name) { return greeting + ", " + name; }
print(greet("Spark"));