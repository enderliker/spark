var a = [10, 20, 30];
print(a[-1]);
print(a[-2]);
print(a[0]);

var s = "spark";
print(s[-1]);
print(s[-5]);

print(substr("abcdef", -3));
print(substr("abcdef", -4, 2));
print(substr("abcdef", 1, 3));
print(substr("abcdef", 100));

print(slice([1, 2, 3], -2));
print(slice([1, 2, 3], 0, -1));
print(slice([1, 2, 3], -100));
print(slice("abcdef", 2, -1));
