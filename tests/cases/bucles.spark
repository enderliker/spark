var total = 0;
for (var i = 1; i <= 5; i += 1) {
    total += i;
}
print(total);

var j = 0;
while (j < 3) {
    j += 1;
}
print(j);

for (var i = 0; i < 10; i += 1) {
    if (i % 2 == 0) {
        continue;
    }
    if (i > 7) {
        break;
    }
    print(i);
}

for (var i = 0; i < 3; i += 1) {
    for (var k = 0; k < 3; k += 1) {
        if (k == 1) {
            break;
        }
        print(i, k);
    }
}

var k = 0;
var suma = 0;
while (k < 5) {
    k += 1;
    if (k == 3) {
        continue;
    }
    suma += k;
}
print("while-continue", suma);

var n = 0;
for (;;) {
    n += 1;
    if (n == 4) {
        break;
    }
}
print("infinito", n);
