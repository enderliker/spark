// String helpers.
print(contains("hello world", "world"), contains("hello", "xyz"));
print(index_of("hello", "l"), index_of("hello", "z"));
print(starts_with("spark", "spa"), ends_with("spark", "ark"));
print(starts_with("spark", "xyz"), ends_with("a", "abc"));

print(split("a,b,c", ","));
print(split("abc", ""));
print(split("ñandú", ""));

print(join([1, 2, 3], "-"), join(["a", "b"], ""));
print(trim("  hola  "), "|", trim("\t\nhi\n"));
print(upper("Hello ñ"), lower("Hello Ñ"));
print(repeat("ab", 3), repeat("x", 0), "|");
print(replace("banana", "na", "NA"), replace("aaa", "a", "bb"));

print(contains("ñandú", "and"), index_of("ñandú", "ú"));

// Edge cases.
print(split(",a,", ","), split("", ","), split("", ""));
print(join([[1, 2], {"a": 1}], "|"));
print(replace("abc", "z", "y"), len(trim("   \t\n")));
print(starts_with("abc", ""), ends_with("abc", ""));
print(contains("abc", ""), index_of("abc", ""));
print(repeat("", 100000000) == "");