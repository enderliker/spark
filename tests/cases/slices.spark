var a = [0, 1, 2, 3, 4, 5];
print(a[1:4]);
print(a[:2]);
print(a[3:]);
print(a[:]);
print(a[::2]);
print(a[1:5:2]);
print(a[-3:]);
print(a[:-2]);
print(a[-4:-1]);
print(a[4:100]);
print(a[-100:2]);
print(a[5:1]);
print(a[4:1:-1]);
print("abcdef"[1:4]);
print("abcdef"[::-1]);
print(slice(a, 2, 5));
print(slice("hello", 1, 3));
print(a[::2][1:]);
